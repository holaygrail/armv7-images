{
  "sonarr": {
    "upstream": "Sonarr/Sonarr",
    "context": "servarr",
    "dockerfile": "servarr/Dockerfile",
    "port": 8989,
    "health": "/ping",
    "build_args": {
      "APP": "Sonarr",
      "BRANCH": "main",
      "ASSET": "linux-arm",
      "PORT": "8989"
    },
    "smoke_minutes": 10,
    "smoke_log": "Starting migration of Main DB to [0-9]+",
    "smoke_note": "QEMU occasionally crashes (thumb_tr_translate_insn assertion) while running Sonarr; startup is checked via the log."
  },
  "radarr": {
    "upstream": "Radarr/Radarr",
    "context": "servarr",
    "dockerfile": "servarr/Dockerfile",
    "port": 7878,
    "health": "/ping",
    "build_args": {
      "APP": "Radarr",
      "BRANCH": "master",
      "ASSET": "linux-core-arm",
      "PORT": "7878"
    },
    "smoke_minutes": 10,
    "smoke_log": "Starting migration of Main DB to [0-9]+",
    "smoke_note": "Radarr's DB migration 142 hangs under QEMU (works on real armv7 hardware), so only startup is checked."
  },
  "sabnzbd": {
    "upstream": "sabnzbd/sabnzbd",
    "context": "sabnzbd",
    "dockerfile": "sabnzbd/Dockerfile",
    "port": 8080,
    "health": "/api?mode=version",
    "build_args": {},
    "smoke_minutes": 10
  },
  "seerr": {
    "upstream": "seerr-team/seerr",
    "source": true,
    "context": "src",
    "dockerfile": "seerr/Dockerfile",
    "port": 5055,
    "health": "/api/v1/status",
    "build_args": {},
    "smoke_minutes": 20
  },
  "homepage": {
    "upstream": "gethomepage/homepage",
    "source": true,
    "context": "src",
    "dockerfile": "homepage/Dockerfile",
    "port": 3000,
    "health": "/api/healthcheck",
    "build_args": {},
    "smoke_minutes": 10
  }
}
